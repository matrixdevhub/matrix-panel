# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# One-time initial administrator setup token (at least 24 characters). Keep private.
SETUP_TOKEN=replace-with-a-long-random-one-time-setup-token
# Pterodactyl panel. Never expose these values to the browser.
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_APPLICATION_KEY=
# Per-user server controls will require a separately authorized user integration.
PTERODACTYL_CLIENT_KEY=
DATABASE_URL=postgresql://matrix:change-me@localhost:5432/matrix_panel
VITE_API_URL=http://localhost:3001
