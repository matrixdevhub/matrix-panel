# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-before-deployment

# Pterodactyl panel. Never expose these values to the browser.
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_APPLICATION_KEY=
PTERODACTYL_CLIENT_KEY=

# PostgreSQL (used by the API scaffold; never expose credentials to the browser)
DATABASE_URL=postgresql://matrix:change-me@localhost:5432/matrix_panel

# Vite browser API URL
VITE_API_URL=http://localhost:3001
