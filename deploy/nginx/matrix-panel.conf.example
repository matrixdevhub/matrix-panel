server {
    listen 80;
    server_name matrix.example.com;

    # Vite production build. Adjust this path to your deployment directory.
    root /opt/matrix-panel/apps/web/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Keep the API on the same public origin. The API itself should bind only
    # to loopback in production (API_HOST=127.0.0.1).
    location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
